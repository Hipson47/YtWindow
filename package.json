{
  "name": "native-picture-in-picture-toggle",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Brave/Chromium extension that toggles native Picture-in-Picture for the active video.",
  "scripts": {
    "build": "vite build",
    "test": "node --test",
    "check": "npm run build && node scripts/check-extension.js",
    "validate": "npm run check && npm test",
    "launch:brave": "bash scripts/launch-brave-dev.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.0",
    "vite": "^8.0.14"
  }
}
